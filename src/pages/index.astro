---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import lanyard from '../assets/photos/lanyard.jpg';
import graduation from '../assets/photos/graduation.jpg';
import mirror from '../assets/photos/mirror.webp';
import avatar from '../assets/photos/6.jpg';

// Shown in this order; the wide graduation shot is cropped square around the face
const photos = [
	{ src: lanyard, position: 'object-center' },
	{ src: graduation, position: 'object-[80%_50%]' },
	{ src: mirror, position: 'object-center' },
];

// Icon paths from Bootstrap Icons (MIT), 16x16 viewBox
const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/msimonb05',
		path: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/mark-simon-bringas/',
		path: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z',
	},
	{
		label: 'X (Twitter)',
		href: 'https://x.com/msimonb_05',
		path: 'M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z',
	},
];
---

<Base title="Mark Simon Bringas">
	<header class="absolute inset-x-0 top-0 px-4 pt-6 sm:px-10 sm:pt-8">
		<a href="/" class="font-display text-sm font-medium tracking-[0.18em] text-paper/75 uppercase transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua">
			Markymatics
		</a>
	</header>

	<main>
		<section class="relative grid min-h-dvh place-items-center px-4 py-24">
			<div class="flex flex-col items-center gap-6 sm:gap-8">
				<svg
					class="size-7 text-gold sm:size-9"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path d="M12 0C12.9 7.6 16.4 11.1 24 12 16.4 12.9 12.9 16.4 12 24 11.1 16.4 7.6 12.9 0 12 7.6 11.1 11.1 7.6 12 0Z" />
				</svg>
				<h1 class="text-center font-display text-[clamp(2.5rem,8vw,5rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance">
					Woah!
					<span class="block font-light text-aqua">How did you get here<span class="text-gold">?</span></span>
				</h1>
			</div>

			<a
				href="#me"
				aria-label="Scroll down to personal details"
				class="absolute inset-x-0 bottom-6 mx-auto grid size-16 place-items-center rounded-full text-paper/60 transition-colors hover:text-gold focus-visible:outline-2 focus-visible:outline-aqua sm:bottom-10"
			>
				<svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m7 6 5 5 5-5" />
					<path d="m7 13 5 5 5-5" />
				</svg>
			</a>
		</section>

		<div class="mx-auto max-w-2xl px-4 pb-32 lg:max-w-6xl lg:px-10">
			<section id="me" class="pt-16">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
					<div
						id="photos"
						role="img"
						aria-label="Photos of Mark Simon Bringas"
						class="group relative size-[clamp(9rem,50vw,12rem)] shrink-0 overflow-hidden border border-paper/20 sm:size-44 lg:size-64"
					>
						{photos.map((p, i) => (
							<Image
								src={p.src}
								alt=""
								height={512}
								data-photo
								class:list={[
									'absolute inset-0 size-full object-cover transition-opacity duration-1000 group-data-glitching:animate-glitch-jitter group-data-glitching:transition-none',
									p.position,
									i === 0 ? 'opacity-100' : 'opacity-0',
								]}
							/>
						))}
						<Image
							src={avatar}
							alt=""
							height={512}
							data-avatar
							class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-1000 group-data-glitching:animate-glitch-jitter group-data-glitching:transition-none"
						/>
						<!-- Glitch layers: palette-tinted copies of the incoming image, shown only while glitching -->
						<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden bg-aqua bg-cover bg-blend-multiply mix-blend-screen [background-image:var(--glitch-src)] [background-position:var(--glitch-pos)] group-data-glitching:block group-data-glitching:animate-glitch-split-a"></div>
						<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden bg-violet bg-cover bg-blend-multiply mix-blend-screen [background-image:var(--glitch-src)] [background-position:var(--glitch-pos)] group-data-glitching:block group-data-glitching:animate-glitch-split-b"></div>
						<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 hidden h-1 bg-gold group-data-glitching:block group-data-glitching:animate-glitch-bar"></div>
					</div>

					<div class="min-w-0 flex-1">
						<div class="flex items-start gap-3 font-display text-[clamp(2.75rem,9vw,6rem)] leading-[1.02] sm:gap-4">
							<!-- Both names share one grid cell, so the row is always as tall as the longer one and nothing jumps on swap -->
							<div class="grid min-w-0 flex-1">
								<h2 id="name" aria-live="polite" class="col-start-1 row-start-1 font-bold tracking-[-0.035em] text-balance">Mark Simon Bringas</h2>
								<span id="name-alt" aria-hidden="true" class="invisible col-start-1 row-start-1 font-bold tracking-[-0.035em] text-balance">markymatics</span>
							</div>
							<!-- h-[1lh] keeps the button level with the first line when the name wraps -->
							<div class="grid h-[1lh] shrink-0 place-items-center">
								<button
									id="name-toggle"
									type="button"
									aria-label="Swap name and nickname"
									class="grid size-12 cursor-pointer place-items-center rounded-full border border-paper/15 text-aqua transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
								>
									<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m17 2 4 4-4 4" />
										<path d="M3 11v-1a4 4 0 0 1 4-4h14" />
										<path d="m7 22-4-4 4-4" />
										<path d="M21 13v1a4 4 0 0 1-4 4H3" />
									</svg>
								</button>
							</div>
						</div>
						<p class="mt-4 text-lg text-paper/90">Aspiring Software Developer &amp; Data Scientist</p>
						<p class="mt-1 text-paper/65">Computer Science Student @ University of Baguio</p>
					</div>
				</div>

				<hr class="mt-10 h-0.5 w-20 border-0 bg-gold sm:mt-12" />

				<div>
					<p class="mt-10 max-w-[26ch] font-display text-3xl leading-[1.15] font-medium tracking-[-0.025em] text-balance sm:text-4xl lg:text-5xl">
						I <strong class="font-bold">lead and build software</strong> for the problems around me, starting close to home.
					</p>
					<p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-paper/80 lg:text-xl">
						I work as a team lead and back-end developer on projects ranging from public service portals to a
						business system that remains in use. I am also expanding my work into applied AI and data science.
					</p>

					<ul class="mt-8 flex gap-3">
						{socials.map((s) => (
							<li>
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={s.label}
									class="grid size-11 place-items-center rounded-full border border-paper/15 text-paper/75 transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
								>
									<svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d={s.path} />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		</div>
	</main>
</Base>

<script>
	const name = document.getElementById('name');
	const nameAlt = document.getElementById('name-alt');
	const frame = document.getElementById('photos');
	const photos = frame.querySelectorAll('[data-photo]');
	const avatar = frame.querySelector('[data-avatar]');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	let current = 0;
	let marky = false;
	let timers = [];

	const setVisible = (img, on) =>
		img.classList.replace(on ? 'opacity-0' : 'opacity-100', on ? 'opacity-100' : 'opacity-0');
	const shown = () => (marky ? avatar : photos[current]);

	function render() {
		photos.forEach((p, i) => setVisible(p, !marky && i === current));
		setVisible(avatar, marky);
		frame.setAttribute('aria-label', marky ? 'Manga avatar of markymatics' : 'Photos of Mark Simon Bringas');
	}

	function glitch() {
		timers.forEach(clearTimeout);
		const next = shown();
		frame.style.setProperty('--glitch-src', `url("${next.currentSrc || next.src}")`);
		frame.style.setProperty('--glitch-pos', getComputedStyle(next).objectPosition);
		delete frame.dataset.glitching;
		void frame.offsetWidth; // restart the animation on rapid clicks
		frame.dataset.glitching = '';
		timers = [setTimeout(render, 150), setTimeout(() => delete frame.dataset.glitching, 450)];
	}

	document.getElementById('name-toggle').addEventListener('click', () => {
		[name.textContent, nameAlt.textContent] = [nameAlt.textContent, name.textContent];
		marky = !marky;
		reduceMotion ? render() : glitch();
	});

	if (!reduceMotion) {
		setInterval(() => {
			if (document.hidden || marky) return;
			current = (current + 1) % photos.length;
			render();
		}, 8000);
	}
</script>
