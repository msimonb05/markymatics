---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BackToTop from '../components/BackToTop.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import ProjectPeek from '../components/ProjectPeek.astro';
import Star from '../components/Star.astro';
import TechPills from '../components/TechPills.astro';
import { skills } from '../data/skills.js';
import { socials } from '../data/socials.js';
import cordinnovationPic from '../assets/photos/cordinnovation_pic.jpg';
import graduationPic from '../assets/photos/graduation_pic.jpg';
import mirrorSelfie from '../assets/photos/mirror_selfie.webp';
import kiibo from '../assets/photos/kiibo.jpg';

// Shown in this order; the wide graduation shot is cropped square around the face
const photos = [
	{ src: cordinnovationPic, position: 'object-center' },
	{ src: graduationPic, position: 'object-[80%_50%]' },
	{ src: mirrorSelfie, position: 'object-center' },
];

const projects = (await getCollection('projects')).sort((a, b) => b.data.sort - a.data.sort);
const led = projects.filter((p) => p.data.group === 'led');
const built = projects.filter((p) => p.data.group === 'built');
---

<Base title="Mark Simon Bringas">
	<main>
		<section data-hero class="relative grid min-h-svh place-items-center px-4 py-24">
			<div class="flex flex-col items-center gap-6 sm:gap-8">
				<Star class="size-7 sm:size-9" />
				<h1 tabindex="-1" aria-label="Woah! How did you get here?" class="text-center font-display focus:outline-none text-[clamp(3rem,10vw,6.5rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance">
					<span data-woah class="inline-block">Woah!</span>
					<span class="block font-light text-aqua">{[...'How did you get here'].map((ch) => (ch === ' ' ? ' ' : <span data-char data-glyph={ch}>{ch}</span>))}<span class="text-gold">?</span></span>
				</h1>
			</div>

			<a
				href="#me"
				aria-label="Scroll down to personal details"
				title="Scroll down to personal details"
				class="absolute inset-x-0 bottom-6 mx-auto grid size-16 place-items-center rounded-full text-paper/60 transition-colors hover:text-gold focus-visible:outline-2 focus-visible:outline-aqua sm:bottom-10"
			>
				<svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m7 6 5 5 5-5" />
					<path d="m7 13 5 5 5-5" />
				</svg>
			</a>
		</section>

		<div class="mx-auto max-w-2xl px-4 pb-32 lg:max-w-6xl lg:px-10">
			<section id="me" class="flex min-h-svh flex-col justify-center py-12">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
					<div
						id="photos"
						title="It’s me~"
						role="img"
						aria-label="Photos of Mark Simon Bringas"
						class="group relative size-[clamp(9rem,50vw,12rem)] shrink-0 overflow-hidden border border-paper/20 sm:size-44 lg:size-64"
					>
						{photos.map((p, i) => (
							<Image
								src={p.src}
								alt=""
								height={512}
								data-photo
								class:list={[
									'absolute inset-0 size-full object-cover transition-opacity duration-1000 group-data-glitching:animate-glitch-jitter group-data-glitching:transition-none',
									p.position,
									i === 0 ? 'opacity-100' : 'opacity-0',
								]}
							/>
						))}
						<Image
							src={kiibo}
							alt=""
							height={512}
							data-kiibo
							class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-1000 group-data-glitching:animate-glitch-jitter group-data-glitching:transition-none"
						/>
						<!-- Glitch layers: palette-tinted copies of the incoming image, shown only while glitching -->
						<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden bg-aqua bg-cover bg-blend-multiply mix-blend-screen [background-image:var(--glitch-src)] [background-position:var(--glitch-pos)] group-data-glitching:block group-data-glitching:animate-glitch-split-a"></div>
						<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden bg-violet bg-cover bg-blend-multiply mix-blend-screen [background-image:var(--glitch-src)] [background-position:var(--glitch-pos)] group-data-glitching:block group-data-glitching:animate-glitch-split-b"></div>
						<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 hidden h-1 bg-gold group-data-glitching:block group-data-glitching:animate-glitch-bar"></div>
					</div>

					<div class="min-w-0 flex-1">
						<div class="flex items-start gap-3 font-display text-display sm:gap-4">
							<!-- Both names share one grid cell, so the row is always as tall as the longer one and nothing jumps on swap -->
							<div class="grid min-w-0 flex-1">
								<h2 id="name" aria-live="polite" class="col-start-1 row-start-1 font-bold text-balance">Mark Simon Bringas</h2>
								<span id="name-alt" aria-hidden="true" class="invisible col-start-1 row-start-1 font-bold text-balance">markymatics</span>
							</div>
							<!-- h-[1lh] keeps the button level with the first line when the name wraps -->
							<div class="grid h-[1lh] shrink-0 place-items-center">
								<button
									id="name-toggle"
									title="Swap my name~"
									type="button"
									aria-label="Swap name and nickname"
									class="grid size-12 cursor-pointer place-items-center rounded-full border border-paper/15 text-aqua transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
								>
									<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m17 2 4 4-4 4" />
										<path d="M3 11v-1a4 4 0 0 1 4-4h14" />
										<path d="m7 22-4-4 4-4" />
										<path d="M21 13v1a4 4 0 0 1-4 4H3" />
									</svg>
								</button>
							</div>
						</div>
						<p class="mt-3 text-lead text-paper/90">Aspiring Software Developer &amp; Data Scientist</p>
						<p class="text-body text-paper/65">Computer Science Student @ University of Baguio</p>
					</div>
				</div>

				<hr class="mt-8 h-0.5 w-20 border-0 bg-gold sm:mt-10" />

				<div>
					<p class="mt-8 max-w-[26ch] font-display text-headline font-medium text-balance">
						I <strong class="font-bold">lead and build software</strong> for the problems around me, starting close to home.
					</p>
					<p class="mt-5 max-w-[65ch] text-lead text-paper/80">
						I work as a team lead and back-end developer on projects ranging from public service portals to a
						business system that remains in use. I am also expanding my work into applied AI and data science.
					</p>

					<ul class="mt-6 flex gap-3">
						{socials.map((s) => (
							<li>
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={s.label}
									title={s.label}
									class="grid size-11 place-items-center rounded-full border border-paper/15 text-paper/75 transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
								>
									<svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d={s.path} />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section id="projects" aria-labelledby="projects-title" class="mt-16 sm:mt-24">
				<Star divider />
				<h2 data-reveal style="--i: 1" id="projects-title" class="font-display text-display font-bold">Projects</h2>

				<h3 data-reveal class="mt-14 font-display text-headline font-bold">Led and built</h3>
				<p data-reveal style="--i: 1" class="mt-3 max-w-[60ch] text-body text-paper/70">
					Projects where I led the team and also built a core part of the system myself.
				</p>
				<ul class="mt-6 divide-y divide-paper/10 border-y border-paper/10">
					{led.map((p) => <ProjectEntry project={p} />)}
				</ul>

				<h3 data-reveal class="mt-20 font-display text-headline font-bold">Built</h3>
				<p data-reveal style="--i: 1" class="mt-3 max-w-[60ch] text-body text-paper/70">Projects where I worked as a developer.</p>
				<ul class="mt-6 divide-y divide-paper/10 border-y border-paper/10">
					{built.map((p) => (
						<li data-reveal class="py-6">
							<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
								<h4 class="font-display text-title font-bold">
									<a href={`/projects/${p.id}/`} class="transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua">
										{p.data.short}
									</a>
								</h4>
								<p class="text-small text-paper/65">{[p.data.role, p.data.team].filter(Boolean).join(' · ')}</p>
								<p class="text-small text-paper/65 tabular-nums sm:ml-auto">{p.data.period}</p>
							</div>
							<p class="mt-2 max-w-[65ch] text-lead text-paper/85">{p.data.tagline}</p>
							<div class="mt-4">
								<TechPills stack={p.data.stack} />
							</div>
							<div class="mt-4 empty:hidden">
								<ProjectPeek project={p} count={3} />
							</div>
							<div class="mt-4">
								<ProjectLinks project={p} more />
							</div>
						</li>
					))}
				</ul>
			</section>

			<section id="skills" aria-labelledby="skills-title" class="mt-24 sm:mt-32">
				<Star divider />
				<h2 data-reveal style="--i: 1" id="skills-title" class="font-display text-display font-bold">Skills</h2>
				<ul class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{skills.map((s, i) => (
						<li data-reveal style={`--i: ${i}`} class="border-t border-paper/10 pt-5">
							<h3 class="font-display text-title font-bold">{s.group}</h3>
							<div class="mt-4">
								<TechPills stack={s.items} />
							</div>
						</li>
					))}
				</ul>
			</section>

			<Certifications />
			<Contact />
		</div>
	</main>
	<BackToTop />
</Base>

<script>
	const name = document.getElementById('name');
	const nameAlt = document.getElementById('name-alt');
	const frame = document.getElementById('photos');
	const photos = frame.querySelectorAll('[data-photo]');
	const kiibo = frame.querySelector('[data-kiibo]');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	let current = 0;
	let marky = false;
	let timers = [];

	const setVisible = (img, on) =>
		img.classList.replace(on ? 'opacity-0' : 'opacity-100', on ? 'opacity-100' : 'opacity-0');
	const shown = () => (marky ? kiibo : photos[current]);

	function render() {
		photos.forEach((p, i) => setVisible(p, !marky && i === current));
		setVisible(kiibo, marky);
		frame.setAttribute('aria-label', marky ? 'Manga avatar of markymatics' : 'Photos of Mark Simon Bringas');
	}

	function glitch() {
		timers.forEach(clearTimeout);
		const next = shown();
		frame.style.setProperty('--glitch-src', `url("${next.currentSrc || next.src}")`);
		frame.style.setProperty('--glitch-pos', getComputedStyle(next).objectPosition);
		delete frame.dataset.glitching;
		void frame.offsetWidth; // restart the animation on rapid clicks
		frame.dataset.glitching = '';
		timers = [setTimeout(render, 150), setTimeout(() => delete frame.dataset.glitching, 450)];
	}

	document.getElementById('name-toggle').addEventListener('click', () => {
		[name.textContent, nameAlt.textContent] = [nameAlt.textContent, name.textContent];
		marky = !marky;
		reduceMotion ? render() : glitch();
	});

	if (!reduceMotion) {
		setInterval(() => {
			if (document.hidden || marky) return;
			current = (current + 1) % photos.length;
			render();
		}, 8000);
	}
</script>

<script>
	// Hero: "How did you get here" decodes from random glyphs, then "Woah!" glitches now and then
	const motionOk = !matchMedia('(prefers-reduced-motion: reduce)').matches;
	const hero = document.querySelector('[data-hero]');
	const title = hero.querySelector('h1');
	const woah = title.querySelector('[data-woah]');
	const letters = [...title.querySelectorAll('[data-char]')];
	const GLYPHS = '▓▒░#%&@$01';
	const TICK_MS = 70; // about 14 frames a second, stepped like the rain
	const TICKS = 15; // about 1 second to fully decode
	const GLITCH_EVERY_MS = 10_000;
	let heroOnScreen = true;

	function glitch() {
		if (!heroOnScreen || document.hidden) return;
		delete woah.dataset.glitching;
		void woah.offsetWidth; // restart the animation
		woah.dataset.glitching = '';
		setTimeout(() => delete woah.dataset.glitching, 450);
	}

	if (motionOk) {
		new IntersectionObserver(([e]) => (heroOnScreen = e.isIntersecting)).observe(hero);
		title.dataset.decoding = '';
		let tick = 0;
		const decode = setInterval(() => {
			tick++;
			const resolved = Math.ceil((tick / TICKS) * letters.length);
			letters.forEach((el, i) => {
				if (i < resolved) el.dataset.done = '';
				else el.dataset.glyph = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
			});
			if (resolved < letters.length) return;
			clearInterval(decode);
			delete title.dataset.decoding;
			glitch();
			setInterval(glitch, GLITCH_EVERY_MS);
		}, TICK_MS);
	}
</script>
