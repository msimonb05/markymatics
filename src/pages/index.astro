---
import Base from '../layouts/Base.astro';
---

<Base title="Mark Simon Bringas">
	<header class="absolute inset-x-0 top-0 px-4 pt-6 sm:px-10 sm:pt-8">
		<a href="/" class="font-display text-sm font-medium tracking-[0.18em] text-paper/75 uppercase transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua">
			Markymatics
		</a>
	</header>

	<main>
		<section class="relative grid min-h-dvh place-items-center px-4 py-24">
			<div class="flex flex-col items-center gap-6 sm:gap-8">
				<svg
					class="size-7 text-gold sm:size-9"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path d="M12 0C12.9 7.6 16.4 11.1 24 12 16.4 12.9 12.9 16.4 12 24 11.1 16.4 7.6 12.9 0 12 7.6 11.1 11.1 7.6 12 0Z" />
				</svg>
				<h1 class="text-center font-display text-[clamp(2.5rem,8vw,5rem)] leading-[1.02] font-bold tracking-[-0.035em] text-balance">
					Woah!
					<span class="block font-light text-aqua">How did you get here<span class="text-gold">?</span></span>
				</h1>
			</div>

			<a
				href="#me"
				aria-label="Scroll down to personal details"
				class="absolute inset-x-0 bottom-6 mx-auto grid size-16 place-items-center rounded-full text-paper/60 transition-colors hover:text-gold focus-visible:outline-2 focus-visible:outline-aqua sm:bottom-10"
			>
				<svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m7 6 5 5 5-5" />
					<path d="m7 13 5 5 5-5" />
				</svg>
			</a>
		</section>

		<div class="mx-auto max-w-2xl px-4 pb-32">
			<section id="me" class="pt-16">
				<div class="flex items-center gap-3 sm:gap-4">
					<button
						id="name-toggle"
						type="button"
						aria-label="Swap name and nickname"
						class="grid size-10 shrink-0 cursor-pointer place-items-center rounded-full border border-paper/15 text-aqua transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
					>
						<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m17 2 4 4-4 4" />
							<path d="M3 11v-1a4 4 0 0 1 4-4h14" />
							<path d="m7 22-4-4 4-4" />
							<path d="M21 13v1a4 4 0 0 1-4 4H3" />
						</svg>
					</button>
					<h2 id="name" data-alt="markymatics" aria-live="polite" class="min-w-0 font-display text-[2rem] leading-tight font-bold tracking-[-0.03em] sm:text-5xl">Mark Simon Bringas</h2>
				</div>
				<p class="mt-4 text-lg text-paper/90">Aspiring Software Developer &amp; Data Scientist</p>
				<p class="mt-1 text-paper/65">Computer Science Student @ University of Baguio</p>
			</section>
		</div>
	</main>
</Base>

<script>
	const name = document.getElementById('name');
	document.getElementById('name-toggle').addEventListener('click', () => {
		[name.textContent, name.dataset.alt] = [name.dataset.alt, name.textContent];
	});
</script>
