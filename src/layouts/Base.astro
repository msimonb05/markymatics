---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PixelRain from '../components/PixelRain.astro';

const { title = 'Markymatics' } = Astro.props;
---

<html lang="en" class="scroll-pt-20 motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<!-- .ico only (no SVG icon): its 16px image is hand-drawn on the pixel grid, which an SVG would blur -->
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/markymatics-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Lets the CSS hide not-yet-revealed content only when JavaScript is running -->
		<script is:inline>document.documentElement.classList.add('reveal-ready');</script>
	</head>
	<body class="min-h-dvh bg-ink text-paper font-sans antialiased selection:bg-gold selection:text-ink">
		<PixelRain />
		<Header />
		<slot />
		<Footer />
		<script>
			// Marks each [data-reveal] element once it scrolls into view; the CSS plays its fade-up
			const reveal = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						e.target.dataset.shown = '';
						reveal.unobserve(e.target);
					}
				},
				{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
			);
			document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
		</script>
	</body>
</html>
