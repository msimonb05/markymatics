---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import PixelRain from '../components/PixelRain.astro';

const { title = 'Markymatics' } = Astro.props;
---

<html lang="en" class="motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Lets the CSS hide not-yet-revealed content only when JavaScript is running -->
		<script is:inline>document.documentElement.classList.add('reveal-ready');</script>
	</head>
	<body class="min-h-dvh bg-ink text-paper font-sans antialiased selection:bg-gold selection:text-ink">
		<PixelRain />
		<header class="absolute inset-x-0 top-0 px-4 pt-6 sm:px-10 sm:pt-8">
			<a href="/" class="font-display text-small font-medium tracking-[0.18em] text-paper/75 uppercase transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua">
				Markymatics
			</a>
		</header>
		<slot />
		<script>
			// Marks each [data-reveal] element once it scrolls into view; the CSS plays its stepped fade-up
			const reveal = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						e.target.dataset.shown = '';
						reveal.unobserve(e.target);
					}
				},
				{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
			);
			document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
		</script>
	</body>
</html>
