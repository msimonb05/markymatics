---
const sections = [
	{ id: 'projects', label: 'Projects' },
	{ id: 'skills', label: 'Skills' },
	{ id: 'certifications', label: 'Certifications' },
	{ id: 'contact', label: 'Contact' },
];
const link =
	'transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua';
// view-box origin = the icon's centre, so each line turns around the middle of the button
const line = 'origin-center [transform-box:view-box] motion-safe:transition-[transform,opacity] motion-safe:duration-200 motion-safe:ease-out';
---

<!-- Fixed (always on screen) and see-through: a light ink tint plus blur keeps the text readable over the page -->
<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-ink/45 backdrop-blur-md">
	<div class="flex h-14 items-center justify-between gap-6 px-4 font-display text-small font-medium tracking-[0.18em] text-paper/80 uppercase sm:h-16 sm:px-10">
		<!-- The home page's name swap also updates this (#site-name) -->
		<a href="/" id="site-name" class:list={[link, 'whitespace-nowrap']}>Mark Simon Bringas</a>

		<nav aria-label="Sections" class="hidden md:block">
			<ul class="flex gap-6">
				{sections.map((s) => (
					<li><a href={`/#${s.id}`} class={link}>{s.label}</a></li>
				))}
			</ul>
		</nav>

		<button
			id="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Open menu"
			title="Open menu"
			class="group grid size-10 cursor-pointer place-items-center rounded-full border border-paper/15 text-paper/80 transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua aria-expanded:border-gold/60 aria-expanded:text-gold md:hidden"
		>
			<!-- ☰ morphs into ×: the outer lines slide to the middle and turn 45°, the middle one fades -->
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 7h16" class={line + ' group-aria-expanded:[transform:rotate(45deg)_translateY(5px)]'} />
				<path d="M4 12h16" class={line + ' group-aria-expanded:opacity-0'} />
				<path d="M4 17h16" class={line + ' group-aria-expanded:[transform:rotate(-45deg)_translateY(-5px)]'} />
			</svg>
		</button>
	</div>

	<!-- Phone menu: the palette's indigo with gold and aqua, instead of the page's ink -->
	<!-- Slides down 8px while fading in; data-open is set a frame after un-hiding so the transition runs both ways -->
	<nav
		id="site-menu"
		aria-label="Sections"
		hidden
		class="-translate-y-2 border-t border-aqua/25 bg-indigo px-4 pt-2 pb-6 opacity-0 data-open:translate-y-0 data-open:opacity-100 motion-safe:transition-[opacity,translate] motion-safe:duration-200 motion-safe:ease-out md:hidden"
	>
		<ul class="divide-y divide-aqua/15">
			{sections.map((s, i) => (
				<li>
					<a
						href={`/#${s.id}`}
						class="flex items-baseline gap-4 py-4 font-display text-title font-bold text-paper transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
					>
						<span class="font-display text-small font-medium tracking-[0.16em] text-aqua">0{i + 1}</span>
						{s.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('site-menu');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const SLIDE_MS = 200; // matches duration-200 on the menu
	let open = false;
	let closing = 0;

	function setOpen(next) {
		open = next;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		toggle.title = open ? 'Close menu' : 'Open menu';
		clearTimeout(closing);
		if (open) {
			menu.hidden = false;
			void menu.offsetHeight; // apply the hidden-state styles first, so the slide-in has a start point
			menu.dataset.open = '';
		} else {
			delete menu.dataset.open;
			// Keep it in the page until the slide-out finishes, then hide it from screen readers and Tab
			if (reduceMotion.matches) menu.hidden = true;
			else closing = setTimeout(() => (menu.hidden = true), SLIDE_MS);
		}
	}

	toggle.addEventListener('click', () => setOpen(!open));
	// Picking a section, pressing Esc, tapping outside or widening past the phone layout all close it
	menu.addEventListener('click', (e) => e.target.closest('a') && setOpen(false));
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape' || !open) return;
		setOpen(false);
		toggle.focus();
	});
	document.addEventListener('click', (e) => open && !header.contains(e.target) && setOpen(false));
	matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
