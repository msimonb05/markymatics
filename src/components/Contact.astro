---
import Star from './Star.astro';
import { socials } from '../data/socials.js';

// Public by design; set PUBLIC_TURNSTILE_SITE_KEY in Cloudflare Pages
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const label = 'font-display text-small font-medium tracking-[0.16em] text-aqua uppercase';
const field =
	'mt-2 block w-full border border-paper/15 bg-ink/60 px-4 py-3 text-body text-paper placeholder:text-paper/40 focus-visible:border-aqua focus-visible:outline-none';
---

<section id="contact" aria-labelledby="contact-title" class="mt-24 sm:mt-32">
	<Star divider />
	<h2 id="contact-title" class="font-display text-display font-bold text-balance">Woah! You made it to the bottom...</h2>
	<p class="mt-5 max-w-[60ch] text-lead text-paper/80">
		I really appreciate you taking the time to look through my work. Send me a message and I'll get back to you.
	</p>

	<form id="contact-form" action="/api/contact" method="post" class="mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
		<label class="block">
			<span class={label}>Name</span>
			<input name="name" required maxlength="100" autocomplete="name" placeholder="Your name" class={field} />
		</label>
		<label class="block">
			<span class={label}>Email</span>
			<input name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" class={field} />
		</label>
		<label class="block sm:col-span-2">
			<span class={label}>Message</span>
			<textarea name="message" required maxlength="5000" rows="5" placeholder="What would you like to work on?" class={field}></textarea>
		</label>
		<!-- Honeypot: hidden from people, filled in by bots -->
		<div aria-hidden="true" class="absolute -left-[9999px]">
			<label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
		</div>
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:col-span-2">
			<button
				type="submit"
				class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-gold px-6 py-3 font-display text-body font-bold text-ink transition-colors hover:bg-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua disabled:cursor-wait disabled:opacity-60"
			>
				Send message
			</button>
			<p id="contact-status" role="status" class="text-body text-paper/80"></p>
			<!-- Last in the row: its empty box adds no visible space until a challenge shows -->
			<div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-appearance="interaction-only"></div>
		</div>
	</form>

	<p class="mt-12 text-body text-paper/70">Prefer another way? Find me on GitHub, LinkedIn or X.</p>
	<ul class="mt-4 flex gap-3">
		{socials.map((s) => (
			<li>
				<a
					href={s.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${s.label} (opens in a new tab)`}
					class="grid size-11 place-items-center rounded-full border border-paper/15 text-paper/75 transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua"
				>
					<svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
				</a>
			</li>
		))}
	</ul>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('contact-status');
	const button = form.querySelector('button[type="submit"]');
	const loaded = performance.now();

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		button.disabled = true;
		status.textContent = 'Sending...';
		try {
			const body = new FormData(form);
			// Time on the page; the server drops posts made faster than a person could type
			body.append('elapsed', String(Math.round(performance.now() - loaded)));
			const res = await fetch(form.action, { method: 'POST', body });
			const data = await res.json().catch(() => ({}));
			if (!res.ok) throw new Error(data.error);
			form.reset();
			status.textContent = "Thanks! Your message is on its way. I'll reply soon.";
		} catch (err) {
			status.textContent = err.message || "Your message couldn't be sent. Please try again, or reach me on LinkedIn.";
		} finally {
			window.turnstile?.reset();
			button.disabled = false;
		}
	});
</script>
