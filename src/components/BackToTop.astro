<!-- Hidden until the hero is out of view; also hidden while the contact form is on screen so it never covers it -->
<button
	id="back-to-top"
	type="button"
	aria-label="Back to top"
	title="Back to top"
	hidden
	class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 grid size-11 cursor-pointer place-items-center rounded-full border border-paper/15 bg-ink/90 text-paper/75 transition-colors hover:border-gold/60 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua sm:right-6 sm:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
>
	<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m18 15-6-6-6 6" />
	</svg>
</button>

<script>
	const button = document.getElementById('back-to-top');
	const hero = document.querySelector('[data-hero]');
	const form = document.getElementById('contact-form');
	const heading = hero.querySelector('h1');
	const seen = new Map();

	const observer = new IntersectionObserver((entries) => {
		for (const e of entries) seen.set(e.target, e.isIntersecting);
		button.hidden = Boolean(seen.get(hero) || seen.get(form));
	});
	observer.observe(hero);
	if (form) observer.observe(form);

	button.addEventListener('click', () => {
		// Scroll behavior comes from the page's motion-safe:scroll-smooth, so reduced-motion visitors jump instantly
		window.scrollTo({ top: 0 });
		// Move keyboard focus too, so Tab continues from the top instead of the bottom
		heading.focus({ preventScroll: true });
	});
</script>
