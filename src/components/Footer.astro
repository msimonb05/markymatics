---
import Star from './Star.astro';

// Build date, so "Updated" changes on every deploy without anyone editing it
const updated = new Date().toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'Asia/Manila' });
---

<footer class="mx-auto mt-24 max-w-2xl px-4 pb-10 sm:mt-32 lg:max-w-6xl lg:px-10">
	<Star divider />
	<p data-reveal style="--i: 1" class="font-display text-headline font-light text-aqua">
		Thanks for stopping by<span class="text-gold">.</span>
	</p>
	<div class="mt-12 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t border-paper/10 pt-6 text-small text-paper/65">
		<p>Designed and built by Mark Simon Bringas · <span class="whitespace-nowrap">Updated {updated}</span></p>
		<a
			href="#top"
			id="footer-top"
			class="transition-colors hover:text-gold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua"
		>
			Back to top <span aria-hidden="true">↑</span>
		</a>
	</div>
</footer>

<script>
	// A plain #top link adds a history entry, so the browser's Back (or a project page's Back link)
	// would return to the footer. Scrolling by script keeps history untouched; #top stays as the no-JS fallback.
	document.getElementById('footer-top').addEventListener('click', (e) => {
		e.preventDefault();
		window.scrollTo({ top: 0 });
		document.getElementById('site-name').focus({ preventScroll: true });
	});
</script>
