---
import { Image } from 'astro:assets';
import { screenshotsFor } from '../data/screenshots.js';

const { project, count = 4 } = Astro.props;
// The wide three-phone composite is left out; it reads poorly as a thumbnail
const shots = screenshotsFor(project.id).filter((s) => !s.key.endsWith('-mobile'));
const portrait = shots.length > 0 && shots.every((s) => s.portrait);
---

{shots.length > 0 && (
	<a
		href={`/projects/${project.id}/`}
		aria-label={`See ${project.data.short} screenshots`}
		class="group flex gap-3 overflow-x-auto [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua"
	>
		{shots.slice(0, portrait ? count + 1 : count).map((s) => (
			<Image
				src={s.src}
				alt=""
				widths={[240, 480]}
				sizes="240px"
				class:list={[
					'shrink-0 border border-paper/15 object-cover object-top transition-colors group-hover:border-gold/60',
					portrait ? 'h-48 w-auto sm:h-56' : 'aspect-16/10 w-44 sm:w-56',
				]}
			/>
		))}
	</a>
)}
