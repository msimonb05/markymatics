---
// The gold four-point star from the hero; `divider` adds a thin line after it, used above section headings
const { class: className = 'size-5 shrink-0 sm:size-6', divider = false } = Astro.props;
---

{divider ? (
	<div class="mb-6 flex items-center gap-4" aria-hidden="true">
		<svg class:list={['text-gold', className]} viewBox="0 0 24 24" fill="currentColor">
			<path d="M12 0C12.9 7.6 16.4 11.1 24 12 16.4 12.9 12.9 16.4 12 24 11.1 16.4 7.6 12.9 0 12 7.6 11.1 11.1 7.6 12 0Z" />
		</svg>
		<span class="h-px flex-1 bg-paper/15"></span>
	</div>
) : (
	<svg class:list={['text-gold', className]} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path d="M12 0C12.9 7.6 16.4 11.1 24 12 16.4 12.9 12.9 16.4 12 24 11.1 16.4 7.6 12.9 0 12 7.6 11.1 11.1 7.6 12 0Z" />
	</svg>
)}
